<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.garage.dao.SparePartDAO,com.garage.model.SparePart4" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%
    String id = request.getParameter("id"); SparePart4 part = null;
    try { if (id != null && !id.isBlank()) part = new SparePartDAO().findById(id).orElse(null); }
    catch (java.sql.SQLException exception) { response.sendError(503, "Không đọc được dữ liệu phụ tùng."); return; }
    if (part == null) { response.sendError(404, "Không tìm thấy phụ tùng."); return; }
    request.setAttribute("part", part); request.setAttribute("keyword", request.getParameter("txtKeyword")); request.setAttribute("type", request.getParameter("cboType"));
%>
<c:url var="backUrl" value="/customer/SearchServiceAnhParePart4.jsp"><c:param name="txtKeyword" value="${keyword}"/><c:param name="cboType" value="${type}"/></c:url>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin chi tiết phụ tùng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/styles.css"></head>
<body class="customer-wireframe"><main class="customer-screen customer-detail-screen"><h1>Thông tin chi tiết phụ tùng</h1><section class="customer-detail-layout"><div class="customer-detail-image"><c:choose><c:when test="${not empty part.imageUrl}"><img src="<c:out value='${part.imageUrl}'/>" alt="Ảnh <c:out value='${part.partCode}'/>"/></c:when><c:otherwise>Chưa có ảnh</c:otherwise></c:choose></div><table class="customer-detail-table"><tbody><tr><th>Mã phụ tùng:</th><td id="lblPartId"><c:out value="${part.partCode}"/></td></tr><tr><th>Tên phụ tùng:</th><td id="lblPartName"><c:out value="${part.partName}"/></td></tr><tr><th>Nhãn hiệu:</th><td id="lblBrand"><c:out value="${part.brand}" default="Chưa cập nhật"/></td></tr><tr><th>Xuất xứ:</th><td id="lblOrigin"><c:out value="${part.origin}" default="Chưa cập nhật"/></td></tr><tr><th>Quy cách:</th><td id="lblSpecifications"><c:out value="${part.specifications}" default="Chưa cập nhật"/></td></tr><tr><th>Đơn vị tính:</th><td id="lblUnit"><c:out value="${part.unit}"/></td></tr><tr><th>Mô tả:</th><td id="lblDescription"><c:out value="${part.description}"/></td></tr><tr><th>Đơn giá:</th><td id="lblSellingPrice"><fmt:formatNumber value="${part.sellingPrice}" pattern="#,##0"/> đồng/<c:out value="${part.unit}"/></td></tr><tr><th>Tồn kho:</th><td id="lblStockQuantity">${part.stockQuantity} <c:out value="${part.unit}"/></td></tr><tr><th>Bảo hành:</th><td id="lblWarrantyPeriod">${part.warrantyPeriod} tháng</td></tr><tr><th>Trạng thái:</th><td id="lblBusinessStatus"><c:choose><c:when test="${part.businessStatus eq 'ACTIVE'}">Đang kinh doanh</c:when><c:otherwise>Ngừng kinh doanh</c:otherwise></c:choose></td></tr><tr><th>Loại phụ tùng:</th><td id="sparePartCategory"><c:out value="${part.sparePartCategory.categoryName}" default="Chưa phân loại"/></td></tr></tbody></table></section><a id="btnBackToSearch" class="customer-back-button" href="${backUrl}">Quay lại</a></main></body></html>
